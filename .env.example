# Supabase Params
SUPABASE_HOST=YOUR-SUPABASE-PROJECT.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_USER=postgres
SUPABASE_POOL_MODE=session
SUPABASE_PASSWORD=replace-with-db-password
OFFERS_TABLE_NAME=oil_offers_export

# CORS (optional)
# Comma-separated list of allowed origins, or * for all
# Example: http://localhost:3000,https://myapp.com
CORS_ORIGINS=*
# Comma-separated list of allowed methods, or * for all
CORS_ALLOW_METHODS=*
# Comma-separated list of allowed headers, or * for all
CORS_ALLOW_HEADERS=*
# Allow credentials (cookies/authorization headers) to be included in cross-site requests
CORS_ALLOW_CREDENTIALS=false
