# Supabase Params
SUPABASE_HOST=YOUR-SUPABASE-PROJECT.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_USER=postgres
SUPABASE_POOL_MODE=session
